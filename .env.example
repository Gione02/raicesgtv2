# ============================================================================
# RaícesGT - Plantilla de variables de entorno
# Copia este archivo como ".env" y llena las contraseñas
# (pídeselas al responsable del proyecto, no se suben al repositorio).
# ============================================================================

# --- Oracle (base de datos) -------------------------------------------------
ORACLE_PASSWORD=
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=
DB_PASSWORD=

# --- API (backend FastAPI) --------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Orígenes que pueden llamar a la API (web y app móvil), separados por coma
CORS_ORIGINS=http://localhost,http://localhost:80
